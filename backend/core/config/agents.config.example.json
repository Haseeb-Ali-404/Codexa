{
  "defaults": {
    "timeout_seconds": 120
  },
  "agents": {
    "planner": {
      "provider": "openai",
      "model": "gpt-4o",
      "temperature": 0.3,
      "max_tokens": 2000,
      "api_key_env": "OPENAI_API_KEY",
      "fallbacks": [
        { "provider": "groq", "model": "llama-3.3-70b-versatile" },
        { "provider": "gemini", "model": "gemini-2.5-flash-lite" }
      ]
    },
    "developer": {
      "provider": "groq",
      "model": "llama-3.3-70b-versatile",
      "temperature": 0.2,
      "max_tokens": 8192,
      "fallbacks": [
        { "provider": "openai", "model": "gpt-4o" }
      ]
    },
    "debugger": {
      "provider": "gemini",
      "model": "gemini-2.5-flash-lite"
    },
    "classifier": {
      "provider": "anthropic",
      "model": "claude-3-5-haiku-20241022",
      "fallbacks": [
        { "provider": "openai", "model": "gpt-4o-mini" }
      ]
    },
    "integrator": {
      "provider": "gemini",
      "model": "gemini-2.5-flash-lite",
      "fallbacks": []
    },
    "architect": {
      "provider": "gemini",
      "model": "gemini-2.5-flash",
      "fallbacks": []
    },
    "chat": {
      "provider": "gemini",
      "model": "gemini-2.5-flash-lite",
      "fallbacks": [
        { "provider": "openai", "model": "gpt-4o-mini" }
      ]
    },
    "title": {
      "provider": "gemini",
      "model": "gemini-2.5-flash-lite",
      "fallbacks": []
    },
    "edit": {
      "provider": "gemini",
      "model": "gemini-2.5-flash",
      "temperature": 0.15,
      "max_tokens": 32768,
      "fallbacks": [
        { "provider": "openai", "model": "gpt-4o" }
      ]
    }
  }
}
