{
  "defaults": {
    "timeout_seconds": 120
  },
  "agents": {
    "planner": {
      "provider": "gemini",
      "model": "gemini-2.5-flash-lite",
      "temperature": 0.3,
      "max_tokens": 2000,
      "fallbacks": [
        { "provider": "openai", "model": "gpt-4o-mini" },
        { "provider": "groq", "model": "llama-3.3-70b-versatile" }
      ]
    },
    "developer": {
      "provider": "gemini",
      "model": "gemini-2.5-flash",
      "temperature": 0.2,
      "max_tokens": 3000000,
      "fallbacks": [
        { "provider": "openai", "model": "gpt-4o" }
      ]
    },
    "debugger": {
      "provider": "gemini",
      "model": "gemini-2.5-flash-lite"
    },
    "classifier": {
      "provider": "gemini",
      "model": "gemini-2.5-flash",
      "temperature": 0.1,
      "max_tokens": 512,
      "fallbacks": [
        { "provider": "openai", "model": "gpt-4o-mini" }
      ]
    },
    "integrator": {
      "provider": "gemini",
      "model": "gemini-2.5-flash-lite",
      "fallbacks": []
    },
    "architect": {
      "provider": "gemini",
      "model": "gemini-2.5-flash",
      "temperature": 0.2,
      "max_tokens": 4096,
      "fallbacks": [
        { "provider": "anthropic", "model": "claude-3-5-sonnet-20241022" }
      ]
    },
    "chat": {
      "provider": "gemini",
      "model": "gemini-2.5-flash-lite",
      "temperature": 0.7,
      "max_tokens": 4096,
      "fallbacks": [
        { "provider": "openai", "model": "gpt-4o-mini" }
      ]
    },
    "title": {
      "provider": "gemini",
      "model": "gemini-2.5-flash-lite",
      "temperature": 0.4,
      "max_tokens": 256,
      "fallbacks": [
        { "provider": "openai", "model": "gpt-4o-mini" }
      ]
    },
    "edit": {
      "provider": "gemini",
      "model": "gemini-2.5-flash",
      "temperature": 0.15,
      "max_tokens": 32768,
      "fallbacks": [
        { "provider": "openai", "model": "gpt-4o" }
      ]
    }
  }
}
