# Database
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=codexa

# Auth
JWT_SECRET=change-me
JWT_ALGO=HS256

# LLM providers (set the ones you use; optional keys are only needed for those providers)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=

# Optional: append JSONL usage logs (tokens + estimated USD per call)
# CODEXA_USAGE_LOG_FILE=./logs/llm_usage.jsonl

# Optional: custom pricing table for cost estimates
# CODEXA_PRICING_CONFIG=./core/config/pricing.json

# Optional: re-read .env from disk on every key lookup (development)
# CODEXA_RELOAD_DOTENV=1

# Optional: custom path to agent routing JSON
# CODEXA_AGENTS_CONFIG=./core/config/agents.config.json

# Server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000
